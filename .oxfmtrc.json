{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "src/app/globals.css",
    "functions": ["cn", "cva"]
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    "storybook-static/",
    ".vercel/",
    "*.tsbuildinfo",
    "coverage/",
    "screenshots/",
    "src/lib/transit-api.d.ts",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    ".env*",
    "*.log",
    ".claude/skills/",
    ".claude/settings.local.json"
  ]
}
