{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@erakor/toolchain/oxlint/react.json",
    "./node_modules/@erakor/toolchain/oxlint/storybook.json"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "nextjs"],
  "jsPlugins": ["@erakor/toolchain/oxlint/plugins/secret-env.mjs"],
  "rules": {
    "secret-env/no-public-secret": ["error", { "allow": [] }],
    "react/set-state-in-effect": "error",
    "import/no-anonymous-default-export": "warn"
  },
  "overrides": [
    {
      "files": ["next.config.*"],
      "rules": { "secret-env/no-secret-in-config-env": ["error", { "allow": [] }] }
    }
  ],
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "next-env.d.ts",
    "src/lib/transit-api.d.ts",
    "storybook-static",
    "screenshots"
  ]
}
