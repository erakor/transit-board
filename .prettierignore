node_modules/

# Build outputs
.next/
out/
storybook-static/
.vercel/

# Caches
*.tsbuildinfo

# Test artifacts
coverage/
screenshots/

# Generated files (regenerated unformatted; formatting them only creates churn)
src/lib/transit-api.d.ts
next-env.d.ts

# Lockfiles
pnpm-lock.yaml

# Not code
.env*
*.log

# Vendored skills, kept identical to their source so a refresh diffs cleanly
.claude/skills/
.claude/settings.local.json
