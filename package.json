{
  "name": "transit-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript ${TRANSIT_OPENAPI:-https://$TRANSIT_HOST/openapi.json} -o src/lib/transit-api.d.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "storybook build --quiet && node scripts/storybook-smoke.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@erakor/toolchain": "github:erakor/toolchain#a43487e76663bd84ede121057887848f69e6016d",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-storybook": "10.6.7",
    "husky": "^9.1.7",
    "knip": "^6.46.1",
    "lint-staged": "^17.6.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.33",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,json,md,mdx,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
